<?xml version="1.0" encoding="utf-8"?>
<!-- §9: ni copia en la nube ni transferencia entre dispositivos (Android 12+).
     La clave de la BD vive en el Keystore y no viaja: una copia de la BD sin
     su clave sería ilegible. El respaldo oficial es el archivo .ascend. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
